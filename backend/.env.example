# ── Django ──────────────────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=PASTE_GENERATED_SECRET_KEY_HERE

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_VPS_IP

# ── Google APIs ──────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=PASTE_GOOGLE_PLACES_KEY_HERE
GOOGLE_GEOCODING_API_KEY=PASTE_GOOGLE_GEOCODING_KEY_HERE

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=PASTE_OPENAI_KEY_HERE

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=PASTE_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=PASTE_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_PRICE_BASIC=PASTE_STRIPE_PRICE_BASIC_ID_HERE
STRIPE_PRICE_PRO=PASTE_STRIPE_PRICE_PRO_ID_HERE

# ── Frontend URL (for Stripe redirects + guest check-in links) ───────────────
FRONTEND_URL=https://yourdomain.com

# ── Email (SMTP) — for guest check-in reminder emails ────────────────────────
# Dev default: console backend (prints to terminal, no real emails sent)
# For production, set EMAIL_BACKEND to smtp and fill credentials below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=YOUR_GMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=noreply@guestflowpro.com
